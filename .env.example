# Ничего из этого задавать не обязательно: в docker-compose.yml у каждой
# переменной есть значение по умолчанию, и `make up` работает на чистом клоне
# без единой настройки. Файл нужен только чтобы что-то переопределить -
# например, занятый порт.
#
# Скопировать при необходимости: cp .env.example .env

POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_PORT=5432

# Отдельно про DATABASE_URL: генератор его понимает, dbt - нет. У dbt свои
# параметры в dbt/profiles.yml, и читает он их по одной переменной, а не
# строкой подключения целиком. Если задать только DATABASE_URL, генератор
# уедет в одну базу, а dbt останется в другой, и разъезд будет тихим.
# Поэтому переопределять надо переменные выше, а не строку подключения.
