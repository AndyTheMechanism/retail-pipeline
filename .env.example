# None of this has to be set: every variable in docker-compose.yml has a
# default, and `make up` works on a clean clone with no configuration at all.
# The file exists only so that something can be overridden — a port already in
# use, for instance.
#
# Copy it if you need to: cp .env.example .env

POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_PORT=5432

# A word on DATABASE_URL: the generator understands it, dbt does not. dbt has
# its own parameters in dbt/profiles.yml, and it reads them one variable at a
# time rather than as a whole connection string. Set DATABASE_URL alone and the
# generator goes to one database while dbt stays in another, and the two drift
# apart quietly. So override the variables above, not the connection string.
