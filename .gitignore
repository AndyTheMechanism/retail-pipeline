# Environments. The asterisk is not decoration: there are several of them —
# the generator, dbt, the reconciliation — and without it .venv-dbt would have
# gone into a public commit whole.
.venv*/
venv/
__pycache__/
*.py[cod]
.env

# The data is not committed: the generator and the seed are.
# The list is wider than anything the project can even produce, and that is a
# safety margin: a public repository is where a careless git add -A costs the
# most.
data/
*.csv
*.parquet
*.xlsx
*.zip
*.pbix

# Airflow. The config is deliberately not committed: airflow.cfg is generated,
# it runs to over a hundred kilobytes of somebody else's defaults, and those
# cannot be explained. Everything this project needs is set by six environment
# variables in the Makefile.
airflow/airflow.cfg
airflow/logs/
airflow/alerts.log
airflow/.db-migrated
airflow/*.db
airflow/*.pid
airflow/*.generated
airflow/standalone_admin_password.txt

# dbt
target/
dbt_packages/
logs/
.user.yml

# Editors and the operating system
.idea/
.vscode/
.DS_Store
