# Окружение. Звездочка не для красоты: окружений несколько - генератор, dbt,
# сверка, - и без нее .venv-dbt уехал бы в публичный коммит целиком.
.venv*/
venv/
__pycache__/
*.py[cod]
.env

# Данные не коммитятся: коммитится генератор и seed
data/
*.csv
*.parquet
*.xlsx

# Airflow. Конфиг не коммитится намеренно: airflow.cfg генерируется сам, в нем
# больше ста килобайт чужих умолчаний, и объяснить их нельзя. Все, что нужно
# этому проекту, задается пятью переменными окружения в Makefile.
airflow/airflow.cfg
airflow/logs/
airflow/alerts.log
airflow/.db-migrated
airflow/*.db
airflow/*.pid
airflow/*.generated
airflow/standalone_admin_password.txt

# dbt
target/
dbt_packages/
logs/
.user.yml

# Редакторы и система
.idea/
.vscode/
.DS_Store
